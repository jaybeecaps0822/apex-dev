# apps/api/.env — copy to apps/api/.env and fill in. NEVER commit real values.
DATABASE_URL="postgresql://apex:CHANGE_ME@localhost:5432/apex_dev"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
PORT=4000
APP_ORIGIN="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"
# Email: dev mode logs verification/reset links to console. Set SMTP_* to send real mail.
EMAIL_DEV_MODE="console"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="APEX <no-reply@sanpedro.edu.ph>"
